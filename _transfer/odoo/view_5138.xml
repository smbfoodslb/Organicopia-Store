<list string="Sales Orders" create="0" edit="0" delete="0" default_order="date_order desc">
  <field name="name"/>
  <field name="company_id" string="Company" widget="badge" decoration-warning="company_id == 1" decoration-success="company_id == 3"/>
  <field name="date_order"/>
  <field name="partner_id"/>
  <field name="commitment_date" optional="show"/>
  <field name="amount_total" sum="Total"/>
  <field name="state" widget="badge" decoration-success="state == 'sale'" decoration-info="state in ('draft','sent')"/>
  <field name="invoice_status" optional="show"/>
</list>