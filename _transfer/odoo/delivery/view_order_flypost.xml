<data>
  <xpath expr="//field[@name='payment_term_id']" position="after">
    <field name="x_delivered_by" widget="radio" options="{'horizontal': true}"/>
    <field name="x_collect" widget="radio" options="{'horizontal': true}"/>
    <field name="x_flypost_ref" invisible="x_delivered_by not in ('flypost', 'flypost_pickup')" placeholder="e.g. FPO2755"/>
    <field name="x_flypost_handed" invisible="x_delivered_by not in ('flypost', 'flypost_pickup')"/>
    <field name="x_flypost_collects" invisible="x_delivered_by not in ('flypost', 'flypost_pickup')"/>
  </xpath>
</data>
