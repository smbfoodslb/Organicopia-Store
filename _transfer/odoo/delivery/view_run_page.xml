<t t-name="website.smb_delivery_run_page">
  <html lang="en">
    <head>
      <meta charset="utf-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <meta name="robots" content="noindex, nofollow"/>
      <meta name="referrer" content="no-referrer"/>
      <title>Delivery run</title>
      <style>
        body{margin:0;font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:#f3f6f5;color:#1c2b28;font-size:16px;line-height:1.4}
        .wrap{max-width:640px;margin:0 auto;padding:14px 14px 40px}
        h1{font-size:19px;margin:6px 0 2px;color:#123d36}
        .sub{color:#4d615c;margin-bottom:12px}
        .go{display:block;text-align:center;background:#123d36;color:#fff;text-decoration:none;font-weight:600;padding:13px;border-radius:9px;margin:10px 0 16px}
        .stop{background:#fff;border:1px solid #d5e0dd;border-radius:9px;padding:11px 12px;margin-bottom:10px}
        .top{display:flex;gap:10px;align-items:flex-start}
        .n{flex:none;width:30px;height:30px;border-radius:50%;background:#123d36;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center}
        .t{font-weight:600;color:#123d36}
        .what{display:inline-block;margin-top:6px;padding:3px 9px;border-radius:12px;background:#e6efec;color:#2d4a44;font-size:15px}
        .what.c{background:#fbdcdc;color:#9b1c1c;font-weight:600}
        .p{margin-top:8px;padding-top:8px;border-top:1px solid #e6efec;font-size:15px;color:#34443f}
        .p a{color:#123d36;font-weight:600}
        .nav{display:inline-block;margin-top:8px;font-size:15px;color:#123d36;font-weight:600}
        .note{background:#fff8e1;border:1px solid #f0dc9c;border-radius:9px;padding:10px 12px;margin-bottom:12px}
        .rep{margin-top:10px;padding-top:10px;border-top:1px solid #e6efec}
        .st{font-weight:700;margin-bottom:8px}.st.ok{color:#1d6b3f}.st.no{color:#9b1c1c}
        .b{font:inherit;font-weight:600;padding:10px 14px;border-radius:8px;border:2px solid #123d36;background:#fff;color:#123d36;margin:0 8px 6px 0}
        .b.on.ok{background:#1d6b3f;border-color:#1d6b3f;color:#fff}.b.on.no{background:#9b1c1c;border-color:#9b1c1c;color:#fff}
        .b.no{border-color:#9b1c1c;color:#9b1c1c}
        .why input{font:inherit;width:100%;box-sizing:border-box;padding:10px;border:1px solid #b9c7c3;border-radius:8px;margin:4px 0 8px}
        .cash{margin:0 0 10px}.cash label{display:block;font-weight:600;color:#9b1c1c;margin-bottom:4px}
        .cash input{font:inherit;font-size:20px;font-weight:700;width:170px;padding:9px 10px;border:2px solid #9b1c1c;border-radius:8px}
        .err{color:#9b1c1c;font-size:15px;margin-top:4px}
        .info{background:#e6efec;border-radius:9px;padding:10px 12px;margin-bottom:12px}
        .gone{background:#fff;border:1px solid #d5e0dd;border-radius:9px;padding:16px;margin-top:30px;text-align:center}
      </style>
    </head>
    <body>
      <div class="wrap" t-att-data-t="request.params.get('t') or ''" t-att-data-c="request.csrf_token()">
        <t t-set="tok" t-value="request.params.get('t') or ''"/>
        <t t-set="run" t-value="len(tok) == 32 and request.env['x_delivery_run'].sudo().search([('x_token', '=', tok), ('x_state', '!=', 'cancel')], limit=1)"/>
        <t t-set="fresh" t-value="run and run.x_date and (datetime.date.today() - run.x_date).days &lt;= 7"/>
        <t t-if="not fresh">
          <div class="gone">This delivery run link is not valid any more.</div>
        </t>
        <t t-else="">
          <h1 t-out="run.x_name"/>
          <div class="sub"><t t-out="run.x_stops_label"/> stops · <t t-out="run.x_km_label"/> km · about <t t-out="run.x_duration"/> of driving</div>
          <div t-if="run.x_note" class="note" t-out="run.x_note"/>
          <t t-set="lines" t-value="run.x_line_ids"/>
          <t t-set="locked" t-value="bool(run.x_deliveries_done)"/>
          <t t-set="cashdone" t-value="{e.x_sale_id.id: e for e in request.env['x_staff_entry'].sudo().search([('x_run_id', '=', run.id), ('x_type', '=', 'cash')])}"/>
          <div t-if="lines and locked" class="info">The manager has confirmed the deliveries of this run.</div>
          <div t-elif="lines and run.x_reported == 'all'" class="info">Every stop is reported. The manager will confirm the deliveries.</div>
          <div t-elif="lines" class="info">At each stop, tap Delivered or Not delivered. Where money is collected, check the amount first and change it if the customer paid a different amount. The manager confirms afterwards.</div>
          <a t-if="run.x_route_url" class="go" t-att-href="run.x_route_url" target="_blank" rel="noopener">Open the whole route in Google Maps</a>
          <t t-foreach="json.loads(run.x_stops_json or '[]')" t-as="st">
            <div class="stop" t-attf-id="s#{st['n']}">
              <div class="top">
                <div class="n" t-out="st['n']"/>
                <div>
                  <div class="t" t-out="st['title']"/>
                  <div t-if="st['what']" t-attf-class="what #{'c' if st['collect'] else ''}" t-out="st['what']"/>
                </div>
              </div>
              <t t-foreach="st['people']" t-as="p">
                <div class="p">
                  <div t-if="len(st['people']) &gt; 1" t-out="p['name']"/>
                  <div t-if="p['addr']" t-out="p['addr']"/>
                  <a t-if="p['phone']" t-attf-href="tel:#{p['phone'].replace(' ', '')}" t-out="p['phone']"/>
                </div>
              </t>
              <t t-set="sl" t-value="lines.filtered(lambda l: l.x_stop == st['n'])"/>
              <div t-if="sl" class="rep" t-att-data-stop="st['n']">
                <t t-set="r" t-value="sl[0].x_report"/>
                <div t-if="r == 'delivered'" class="st ok">Reported: delivered</div>
                <div t-if="r == 'failed'" class="st no">Reported: not delivered<t t-if="sl[0].x_report_note">, <t t-out="sl[0].x_report_note"/></t></div>
                <t t-foreach="st.get('cash') or []" t-as="c">
                  <t t-set="en" t-value="cashdone.get(c['sale'])"/>
                  <div t-if="en and en.x_state == 'expected' and not locked" class="cash">
                    <label>Cash received<t t-if="len(st.get('cash')) &gt; 1"> for <t t-out="c['order']"/></t> ($)</label>
                    <input type="number" inputmode="decimal" min="0" step="0.01" t-att-data-sale="c['sale']" t-att-value="'%.2f' % (en.x_input or c['amt'])"/>
                  </div>
                  <div t-elif="en and en.x_state in ('review', 'confirmed')" class="st ok">Cash reported<t t-if="len(st.get('cash')) &gt; 1"> for <t t-out="c['order']"/></t>: $<t t-out="'%.2f' % en.x_input"/></div>
                  <div t-elif="en and en.x_state == 'rejected'" class="st no">Cash not collected<t t-if="len(st.get('cash')) &gt; 1"> for <t t-out="c['order']"/></t></div>
                </t>
                <t t-if="not locked">
                  <button type="button" t-attf-class="b ok #{'on' if r == 'delivered' else ''}" data-s="delivered">Delivered</button>
                  <button type="button" t-attf-class="b no #{'on' if r == 'failed' else ''}" data-s="failed">Not delivered</button>
                  <div class="why" hidden="hidden">
                    <input type="text" maxlength="200" placeholder="Why? (closed, refused, no time...)"/>
                    <button type="button" class="b no on" data-s="send">Send "Not delivered"</button>
                  </div>
                  <div class="err" hidden="hidden">Not saved. Check the connection and try again.</div>
                </t>
              </div>
              <a t-if="st['lat'] and st['lng']" class="nav" target="_blank" rel="noopener" t-attf-href="https://www.google.com/maps/dir/?api=1&amp;destination=#{st['lat']},#{st['lng']}">Navigate to this stop</a>
            </div>
          </t>
        </t>
      </div>
      <script>
        (function () {
          var wrap = document.querySelector('.wrap'), T = wrap.getAttribute('data-t'), C = wrap.getAttribute('data-c');
          function send(box, status, note, btn) {
            var fd = new FormData();
            fd.append('csrf_token', C); fd.append('x_name', 'report'); fd.append('x_token', T);
            fd.append('x_stop', box.getAttribute('data-stop')); fd.append('x_status', status); fd.append('x_note', note || '');
            var cash = [];
            if (status === 'delivered') { Array.prototype.forEach.call(box.querySelectorAll('.cash input'), function (i) { cash.push(i.getAttribute('data-sale') + '=' + (parseFloat(i.value) || 0)); }); }
            fd.append('x_cash', cash.join(','));
            btn.disabled = true; box.querySelector('.err').hidden = true;
            fetch('/website/form/x_delivery_report', { method: 'POST', body: fd })
              .then(function (r) { return r.json(); })
              .then(function (j) { if (!j || !j.id) { throw new Error('no id'); } location.hash = 's' + box.getAttribute('data-stop'); location.reload(); })
              .catch(function () { btn.disabled = false; box.querySelector('.err').hidden = false; });
          }
          document.addEventListener('click', function (e) {
            var btn = e.target.closest ? e.target.closest('.rep .b') : null; if (!btn) { return; }
            var box = btn.closest('.rep'), s = btn.getAttribute('data-s');
            if (s === 'delivered') { send(box, 'delivered', '', btn); }
            else if (s === 'failed') { box.querySelector('.why').hidden = false; box.querySelector('.why input').focus(); }
            else if (s === 'send') { send(box, 'failed', box.querySelector('.why input').value, btn); }
          });
        })();
      </script>
    </body>
  </html>
</t>
