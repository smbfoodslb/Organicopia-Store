<form string="Driver return" create="0">
  <header>
    <field name="x_state" widget="statusbar" options="{'clickable': '1'}"/>
  </header>
  <sheet>
    <div class="oe_title"><h1><field name="x_name" readonly="1"/></h1></div>
    <group>
      <group>
        <field name="x_customer_id" string="Customer" readonly="1"/>
        <field name="x_partner_id" string="Delivery address" readonly="1"/>
        <field name="x_date" string="Reported" readonly="1"/>
        <field name="x_driver" string="Driver" readonly="1"/>
      </group>
      <group>
        <field name="x_run_id" string="Delivery run" readonly="1"/>
        <field name="x_stop" string="Stop" readonly="1"/>
        <field name="x_note" string="Driver's note" readonly="1"/>
        <field name="x_credit_note_id" string="Return invoice (credit note)" domain="[('move_type', '=', 'out_refund')]" options="{'no_create': True}"/>
      </group>
    </group>
    <group string="Photos">
      <field name="x_photo1" widget="image" nolabel="1" colspan="2" options="{'zoom': true, 'size': [0, 600]}" readonly="1"/>
      <field name="x_photo2" widget="image" nolabel="1" colspan="2" options="{'zoom': true, 'size': [0, 600]}" readonly="1" invisible="not x_photo2"/>
      <field name="x_photo3" widget="image" nolabel="1" colspan="2" options="{'zoom': true, 'size': [0, 600]}" readonly="1" invisible="not x_photo3"/>
    </group>
  </sheet>
</form>
