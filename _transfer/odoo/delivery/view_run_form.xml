<form string="Delivery run" create="0" delete="0">
  <header>
    <button name="%(COMPLETE)d" type="action" string="Run completed" class="btn-primary" invisible="x_state in ('done', 'cancel')"/>
    <button name="%(CASHACCEPT)d" type="action" string="Melissa: I received the cash" class="btn-primary" invisible="x_handover != 'wait5'"/>
    <button name="%(DELIVERIES)d" type="action" string="Confirm deliveries" class="btn-primary" groups="account.group_account_manager" invisible="(x_state != 'done' and x_reported != 'all') or x_deliveries_done"/>
    <field name="x_state" widget="statusbar" statusbar_visible="draft,sent,done"/>
  </header>
  <sheet>
    <h1><field name="x_name" readonly="1"/></h1>
    <group>
      <group string="Run">
        <field name="x_date" readonly="1"/>
        <field name="x_who" readonly="1"/>
        <field name="x_vehicle" readonly="1"/>
        <field name="x_stops" readonly="1"/>
        <field name="x_end_label" string="Ends" readonly="1"/>
        <field name="x_route_url" string="Route" widget="url" readonly="1" text="Open in Google Maps"/>
        <field name="x_page_url" string="Deliveries" widget="url" readonly="1" text="Open the stop list to report deliveries" invisible="not x_page_url"/>
        <field name="x_reported" readonly="1" invisible="not x_reported" widget="badge" decoration-warning="x_reported == 'part'" decoration-success="x_reported == 'all'"/>
      </group>
      <group string="When the run is finished">
        <field name="x_km" string="Planned km" readonly="1"/>
        <field name="x_km_final" readonly="x_state in ('done', 'cancel')"/>
        <field name="x_km_reason" placeholder="Why the km differ from the plan" readonly="x_state in ('done', 'cancel')" required="x_state not in ('done', 'cancel') and x_km_final != x_km" invisible="x_km_final == x_km and not x_km_reason"/>
        <field name="x_done_by" widget="radio" readonly="x_state in ('done', 'cancel')"/>
        <field name="x_pin" password="True" invisible="x_state in ('done', 'cancel') and x_handover != 'wait5'" placeholder="Your clock-in PIN"/>
        <field name="x_done_date" readonly="1" invisible="x_state != 'done'"/>
        <field name="x_entry_id" readonly="1" invisible="not x_entry_id" options="{'no_open': True}"/>
        <field name="x_handover" string="Cash collected" readonly="1" invisible="not x_handover" widget="badge" decoration-warning="x_handover == 'wait5'" decoration-success="x_handover in ('ok5', 'owner')"/>
        <field name="x_handover_amount" string="Cash amount ($)" readonly="1" invisible="not x_handover"/>
      </group>
    </group>
    <div class="text-muted" invisible="x_state in ('done', 'cancel')">Correct "Km driven" if the day went differently from the plan (a skipped stop, an extra errand, a trip home that should count). If you change it, write the reason. Then choose your name, enter your clock-in PIN and press Run completed. The km are only recorded then.</div>
    <div class="alert alert-warning" role="alert" invisible="x_handover != 'wait5'">The driver says he handed the cash of this run to Melissa. Melissa: count it against "Cash amount ($)", enter your clock-in PIN in "Your PIN" above and press "Melissa: I received the cash". The payments then go on your statement.</div>
    <!-- owner only: after the run is completed, tick what was delivered and press Confirm deliveries (owner, 23 Nov 2026) -->
    <group string="Deliveries of this run" groups="account.group_account_manager" invisible="x_state != 'done' and not x_reported">
      <field name="x_deliveries_done" invisible="1"/>
      <div class="text-muted" colspan="2" invisible="x_deliveries_done">What the driver reported on the stop list is filled in: reported "Not delivered" is unticked. Untick any other delivery that did not happen, then press Confirm deliveries. The ticked ones are validated in stock; anything short or missing a lot is left open and named. FlyPost drop-offs are not listed.</div>
      <field name="x_line_ids" nolabel="1" colspan="2" readonly="x_deliveries_done">
        <list editable="bottom" create="0" delete="0">
          <field name="x_stop" string="Stop" readonly="1" width="50px"/>
          <field name="x_name" readonly="1"/>
          <field name="x_report" string="Driver reported" readonly="1" widget="badge" decoration-success="x_report == 'delivered'" decoration-danger="x_report == 'failed'"/>
          <field name="x_report_note" string="Reason" readonly="1" optional="show"/>
          <field name="x_report_at" string="Reported at" readonly="1" optional="show"/>
          <field name="x_delivered"/>
          <field name="x_result" readonly="1"/>
        </list>
      </field>
      <field name="x_deliveries_note" readonly="1" invisible="not x_deliveries_note" colspan="2" nolabel="1"/>
    </group>
    <group>
      <field name="x_note" placeholder="Anything the owner should know about this run"/>
    </group>
  </sheet>
  <chatter/>
</form>
