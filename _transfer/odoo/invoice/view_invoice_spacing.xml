<data>
  <!-- Less white space on invoices and credit notes (owner, 23 Nov 2026). The style sits inside the invoice document,
       so quotations, delivery slips and every other report keep their spacing.
       - the customer / shipping address block starts 10px under the header instead of 42px;
       - the customer's Tax ID follows the address and phone directly (the address element kept a 16px bottom margin that only an
         inline style overrides, hence the three attribute xpaths below);
       - "Shipping Address" starts level with the customer's name;
       - a small gap sets "Vendor No." apart from the Tax ID. -->
  <xpath expr="//div[hasclass('page')]" position="inside">
    <style>
      .article > .address.row { padding-top: 10px !important; }
      .article > .address.row [name="shipping_address_block"] > strong { margin-top: 0 !important; }
      .smb_vendor_no { margin-top: 6px; }
    </style>
    <!-- SOUL MIND BODY FOODS SARL (company 3) only: no blank line above the Invoice Date row (owner, 23 Nov 2026).
         The blank line above the product table stays. -->
    <style t-if="o.company_id.id == 3">
      .page > .oe_structure:first-child { display: none !important; }
    </style>
  </xpath>
  <xpath expr="(//address[@t-field='o.partner_id'])[1]" position="attributes"><attribute name="style">margin-bottom: 0 !important</attribute></xpath>
  <xpath expr="(//address[@t-field='o.partner_id'])[2]" position="attributes"><attribute name="style">margin-bottom: 0 !important</attribute></xpath>
  <xpath expr="(//address[@t-field='o.partner_id'])[3]" position="attributes"><attribute name="style">margin-bottom: 0 !important</attribute></xpath>
</data>
