<data>
  <!-- Customer credit note: a "Returns" button at the top opens the return receipt(s) prepared for it
       (stock.picking.x_credit_note_id, see auto_credit_note_return.py). Owner, 27 Nov 2026. The button name is filled
       with the id of the window action "Returns of this credit note" when the view is created. -->
  <xpath expr="//div[@name='button_box']" position="inside">
    <button class="oe_stat_button" type="action" name="__ACTION__" icon="fa-truck" invisible="move_type != 'out_refund' or not x_return_count">
      <field name="x_return_count" widget="statinfo" string="Returns"/>
    </button>
  </xpath>
</data>
