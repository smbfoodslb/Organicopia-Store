<form string="Vehicle use">
  <sheet>
    <div class="alert alert-info" role="alert" invisible="id">One entry per trip. Type the km and choose the vehicle, then save. $0.20 per km goes to the owner of the vehicle; the SMBF Kangoo is recorded with no payment.</div>
    <div class="alert alert-success" role="alert" invisible="not id">Saved. Waiting for the manager to check it.</div>
    <group>
      <group>
        <field name="x_type" invisible="1"/>
        <field name="x_who" string="Who drove?" required="1" readonly="id"/>
        <field name="x_date" required="1" readonly="id"/>
        <field name="x_km" string="Km driven" required="1" readonly="id"/>
        <field name="x_vehicle" string="Vehicle" widget="radio" required="1" readonly="id"/>
      </group>
      <group>
        <field name="x_note" string="Notes (route, reason)" readonly="id"/>
      </group>
    </group>
    <div class="d-flex gap-2 mt-3" invisible="id">
      <button name="__SAVED__" type="action" string="Save" class="btn btn-primary btn-lg"/>
      <button special="cancel" string="Cancel" class="btn btn-secondary btn-lg"/>
    </div>
  </sheet>
</form>
