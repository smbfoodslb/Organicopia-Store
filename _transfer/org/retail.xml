<t t-name="website.org_retail">
<t t-set="env" t-value="website.env"/>
<t t-set="locked" t-value="request.env.user._is_public()"/>
<t t-set="_" t-value="(request.session.get('website_sale_current_pl') != 27) and request.session.update({'website_sale_current_pl': 27})"/>
<t t-set="pl" t-value="env['product.pricelist'].sudo().browse(27)"/>
<t t-set="root" t-value="env['product.public.category'].sudo().search([('name','=','Organicopia'),('parent_id','=',False)], limit=1)"/>
<t t-set="allv" t-value="env['product.product'].sudo().search([('product_tmpl_id.website_published','=',True),('product_tmpl_id.public_categ_ids','child_of',root.id),('product_tmpl_id.website_id','in',[1,False])])"/>
<t t-set="bommap" t-value="env['mrp.bom'].sudo()._bom_find(allv)"/>
<t t-set="cats" t-value="[]"/>
<t t-foreach="env['product.public.category'].sudo().search([('parent_id','=',root.id)], order='sequence, name')" t-as="c">
  <t t-set="tmpls" t-value="env['product.template'].search([('website_published','=',True),('public_categ_ids','in',c.id),('website_id','in',[1,False]),('x_brand','=','Organicopia')], order='website_sequence, name')"/>
  <t t-set="items" t-value="[{'num': v.id, 'tid': tm.id, 'name': v.sudo().x_retail_name or tm.name, 'sub': v.sudo().x_retail_sub or ', '.join(v.product_template_variant_value_ids.mapped('name')), 'brand': tm.sudo().x_brand or '', 'tags': [s for s in (v.sudo().x_retail_tags or tm.sudo().x_size or '').split(' · ') if s], 'certs': [s for s in (tm.sudo().x_certifications or '').split(' · ') if s], 'badges': v.sudo().all_product_tag_ids.mapped('name'), 'oos': bool(c.name != 'Fresh from the Oven' and v.sudo().is_storable and v.sudo().with_context(allowed_company_ids=[1,3]).free_qty &lt;= (tm.sudo().x_web_min_stock or 0) and not (bommap.get(v) and all([l.product_id.with_context(allowed_company_ids=[1,3]).free_qty &gt; 0 for l in bommap[v].bom_line_ids if not l._skip_bom_line(v) and 'Packaging' not in l.product_id.categ_id.complete_name]))), 'usa': bool(v.sudo().is_storable and v.sudo().with_context(allowed_company_ids=[1,3]).free_qty &lt;= 0 and v.sudo().with_context(allowed_company_ids=[2]).free_qty &gt; 0), 'priced': bool(pl._get_product_rule(v, quantity=1.0)), 'tiers': [[q, v.sudo().taxes_id.compute_all(pl._get_product_price(v, q), currency=pl.currency_id, quantity=1.0, product=v)['total_included']] for q in [1, 3, 6]], 'desc': (tm.description_ecommerce or '') + (v.sudo().x_desc_variant or ''), 'country': tm.sudo().country_of_origin.name or '', 'pub': str(tm.sudo().x_published_on or ''), 'restock': str(v.sudo().x_restocked_on or ''), 'img': '/web/image/product.product/%s/image_512' % v.id} for tm in tmpls for v in tm.product_variant_ids if v.sudo().x_retail_name]"/>
  <t t-set="_" t-value="cats.append({'title': c.name, 'desc': c.website_description or '', 'items': items})"/>
</t>
<t t-set="order" t-value="request.cart"/>
<t t-set="data" t-value="{'locked': locked, 'categories': cats, 'cart': {str(l.product_id.id): {'line': l.id, 'q': l.product_uom_qty} for l in (order.order_line if order else []) if not l.is_delivery}, 'user': ('' if locked else (request.env.user.partner_id.name or request.env.user.name)), 'csrf': request.csrf_token(), 'phone': ('' if locked else (request.env.user.partner_id.phone or '')), 'notify': ([] if locked else [n.id for n in env['product.product'].sudo().search([('stock_notification_partner_ids', 'in', [request.env.user.partner_id.id])])])}"/>
